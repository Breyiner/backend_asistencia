# ═══════════════════════════════════════════════════════════════════════════════
# 🌐 CONFIGURACIÓN PRINCIPAL DE LA APLICACIÓN
# ═══════════════════════════════════════════════════════════════════════════════

APP_NAME="Asistencia App"                          # 📛 Nombre visible de la app (título, emails)
APP_ENV=local                                      # 🌍 Entorno: local, staging, production
APP_KEY=                                           # 🔑 Generar: php artisan key:generate (OBLIGATORIO)
APP_DEBUG=true                                     # 🐛 true=desarrollo (muestra errores), false=producción
APP_URL=http://localhost:8000                      # 🌐 URL base de la aplicación

# ═══════════════════════════════════════════════════════════════════════════════
# 🌍 INTERNACIONALIZACIÓN Y LOCALIZACIÓN
# ═══════════════════════════════════════════════════════════════════════════════

APP_LOCALE=es                                      # 🗣️ Idioma principal (es, en, pt)
APP_FALLBACK_LOCALE=en                             # 🔄 Idioma reserva si falla el principal
APP_FAKER_LOCALE=es_CO                             # 🧑‍💻 Datos falsos para seeders (Colombia)

# ═══════════════════════════════════════════════════════════════════════════════
# 🔧 MODO MANTENIMIENTO
# ═══════════════════════════════════════════════════════════════════════════════

APP_MAINTENANCE_DRIVER=file                        # 📂 Almacén de estado mantenimiento (file, cache, database)
# APP_MAINTENANCE_STORE=database                   # 🔄 DB para multi-servidor

# PHP_CLI_SERVER_WORKERS=4                         # 👥 Workers PHP dev server (php artisan serve)

# ═══════════════════════════════════════════════════════════════════════════════
# 🔐 SEGURIDAD Y HASH
# ═══════════════════════════════════════════════════════════════════════════════

BCRYPT_ROUNDS=12                                   # ⚡ Fuerza hash passwords (12=seguro, 15=más lento)

# ═══════════════════════════════════════════════════════════════════════════════
# 📊 LOGGING Y DEBUG
# ═══════════════════════════════════════════════════════════════════════════════

LOG_CHANNEL=stack                                  # 📋 Canal logs: single, daily, slack, stack
LOG_STACK=single                                   # 🔗 Stack de logs (single=un archivo)
LOG_DEPRECATIONS_CHANNEL=null                      # 🗑️ Logs de deprecaciones PHP
LOG_LEVEL=debug                                    # 📈 Nivel: debug, info, warning, error (local=debug)

# ═══════════════════════════════════════════════════════════════════════════════
# 🗄️ BASE DE DATOS MYSQL
# ═══════════════════════════════════════════════════════════════════════════════

DB_CONNECTION=mysql                                 # 🔌 Driver: mysql, pgsql, sqlite, sqlsrv
DB_HOST=127.0.0.1                                  # 🖥️ Host MySQL (localhost, contenedor docker)
DB_PORT=3306                                       # 🔌 Puerto MySQL
DB_DATABASE=asistencia_db                          # 📁 Nombre base datos
DB_USERNAME=root                                   # 👤 Usuario MySQL
DB_PASSWORD=tu_password_seguro                     # 🔐 Contraseña MySQL

# ═══════════════════════════════════════════════════════════════════════════════
# 🍪 SESIONES Y AUTENTICACIÓN
# ═══════════════════════════════════════════════════════════════════════════════

SESSION_DRIVER=database                            # 💾 Almacén sesiones: file, cookie, database, redis
SESSION_LIFETIME=120                               # ⏱️ Minutos (120=2hrs)
SESSION_ENCRYPT=false                              # 🔒 Encriptar sesiones (false=rápido)
SESSION_PATH=/                                     # 📁 Path cookies
SESSION_DOMAIN=null                                # 🌐 Dominio cookies (null=actual)

# ═══════════════════════════════════════════════════════════════════════════════
# 📡 BROADCASTING Y QUEUES (REVERB WEBSOCKET)
# ═══════════════════════════════════════════════════════════════════════════════

BROADCAST_CONNECTION=reverb                        # 📡 Canal real-time: log, reverb, pusher, null
FILESYSTEM_DISK=local                              # 💾 Disco por defecto (local, s3, public)
QUEUE_CONNECTION=database                          # ⏳ Jobs: sync, database, redis, sqs

# ═══════════════════════════════════════════════════════════════════════════════
# 🗃️ CACHE Y PERFORMANCE
# ═══════════════════════════════════════════════════════════════════════════════

CACHE_STORE=file                               # 📦 Cache: file, database, redis, memcached
# CACHE_PREFIX=asistencia_                          # 🏷️ Prefijo cache (evita colisiones)

# ═══════════════════════════════════════════════════════════════════════════════
# 🧨 REDIS (opcional, para cache/sesiones avanzadas)
# ═══════════════════════════════════════════════════════════════════════════════

MEMCACHED_HOST=127.0.0.1                           # 🧠 Memcached (si usas)

REDIS_CLIENT=phpredis                              # 🔴 Cliente Redis
REDIS_HOST=127.0.0.1                               # 🖥️ Redis host
REDIS_PASSWORD=null                                # 🔐 Redis auth
REDIS_PORT=6379                                    # 🔌 Redis puerto

# ═══════════════════════════════════════════════════════════════════════════════
# ✉️ CORREO ELECTRÓNICO
# ═══════════════════════════════════════════════════════════════════════════════

MAIL_MAILER=log                                    # 📧 Driver: smtp, mailgun, ses, log (local=log)
MAIL_ENCRYPTION=null                               # 🔒 tls, ssl (null=ninguno)
MAIL_HOST=127.0.0.1                                # 🖥️ SMTP host
MAIL_PORT=2525                                     # 🔌 SMTP puerto (2525=MailHog dev)
MAIL_USERNAME=null                                 # 👤 SMTP user
MAIL_PASSWORD=null                                 # 🔐 SMTP pass
MAIL_FROM_ADDRESS=noreply@asistencia.com           # 📧 Email remitente
MAIL_FROM_NAME="${APP_NAME}"                       # 👤 Nombre remitente

# ═══════════════════════════════════════════════════════════════════════════════
# ☁️ AWS S3 (archivos adjuntos, backups)
# ═══════════════════════════════════════════════════════════════════════════════

AWS_ACCESS_KEY_ID=                                 # 🔑 AWS IAM key
AWS_SECRET_ACCESS_KEY=                             # 🗝️ AWS secret
AWS_DEFAULT_REGION=us-east-1                       # 🌎 Región AWS
AWS_BUCKET=                                        # 🗄️ Bucket S3
AWS_USE_PATH_STYLE_ENDPOINT=false                  # 🌐 Formato URL S3

# ═══════════════════════════════════════════════════════════════════════════════
# ⚡ VITE/REACT - VARIABLES FRONTEND
# ═══════════════════════════════════════════════════════════════════════════════

VITE_APP_NAME="${APP_NAME}"                        # 📛 Nombre app en React

# 🔐 JWT TOKENS (Sanctum/Passport)
ACCESS_TOKEN_EXPIRATION=60                         # 📅 Minutos token acceso
REFRESH_TOKEN_EXPIRATION=10080                     # 📅 Minutos token refresh (7 días)

# ═══════════════════════════════════════════════════════════════════════════════
# 🔌 LARAVEL REVERB - WEBSOCKET (TIEMPO REAL)
# ═══════════════════════════════════════════════════════════════════════════════

# 🎯 GENERAR: php artisan reverb:generate
REVERB_APP_ID=                      # 🆔 ID aplicación
REVERB_APP_KEY=                     # 🔑 Clave pública (copiar a frontend)
REVERB_APP_SECRET=                  # 🗝️ Secreto privado (SOLO backend)
REVERB_HOST=                        # 🏠 Host WebSocket
REVERB_PORT=                        # 🔌 Puerto WebSocket
REVERB_SCHEME=                      # 🔒 Protocolo (http/ws → https/wss)

# 🚀 FRONTEND VITE (automático desde backend)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ═══════════════════════════════════════════════════════════════════════════════
# 🎯 SETUP INICIAL (ejecutar UNA vez)
# ═══════════════════════════════════════════════════════════════════════════════

# 1. php artisan key:generate
# 2. cp .env.example .env → editar DB_PASSWORD, etc.
# 3. php artisan migrate
# 4. php artisan reverb:generate
# 5. npm install && npm run dev (frontend)
# 6. php artisan reverb:start
# 7. php artisan serve
